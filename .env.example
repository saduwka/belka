# Backend base URL for AI bots (HTTPS tunnel to Pi). Empty = offline rule-based bots only.
# Copy to .env.local for dev. Example tunnels: https://xxxx.trycloudflare.com
VITE_API_URL=

# Vite asset base path. Local dev: /
# GitHub Pages project site: /<repository-name>/  (often set only in CI)
VITE_BASE_PATH=/
