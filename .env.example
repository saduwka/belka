# --- Прод / CI ---
# GitHub Actions: задай Repository variable или Secret `BELKA_API_URL` (https://api.example.com без «/» в конце).
# В сборку попадает только как VITE_API_URL в момент `npm run build` — без этого URL fetch к бэку не пойдёт.
# На бэке нужен CORS: Access-Control-Allow-Origin с https://<user>.github.io (или * на время отладки).
VITE_API_URL=

# Пути эндпоинтов на бэке (если не /api/ai/... — задай свои; в CI тоже через Variables)
# VITE_AI_BOT_MOVE_PATH=/api/ai/bot-move
# VITE_AI_SAVE_GAME_PATH=/api/ai/save-game
# VITE_AI_ANALYZE_GAMES_PATH=/api/ai/analyze-games
# Dev: если прокси не цепляет, задай общий префикс вручную (по умолчанию — первый сегмент bot-move)
# VITE_DEV_PROXY_PREFIX=/api

# --- Только npm run dev: обход CORS без правок бэка ---
# VITE_API_URL оставь пустым, включи прокси:
# VITE_LOCAL_PROXY=1
# VITE_DEV_PROXY_TARGET=https://your-subdomain.ngrok-free.dev

# Vite asset base path. Local dev: /
# GitHub Pages project site: /<repository-name>/  (often set only in CI)
VITE_BASE_PATH=/

# Подробные логи [BelkaAI:bot], [BelkaAI] в консоли (без этого в проде почти только [BELKA GAME])
# VITE_AI_DEBUG=1

# Бэкенд bot-move: в теле POST есть legalMoves — модель должна вернуть card строго из этого массива
# (те же id, что в hand: SUIT_RANK).
